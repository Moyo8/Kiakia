# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# Firebase web config values identify your project; they are not secrets (App Check protects the API).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: reCAPTCHA Enterprise site key (Firebase console > App Check > Apps > your web app).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development only. Leave empty to have the SDK print a fresh debug token in the
# browser console, then register it under App Check > Apps > Manage debug tokens.
# NEVER commit a real token.
VITE_APPCHECK_DEBUG_TOKEN=
